# ===========================
# FlowForge Environment
# ===========================

# Application
NODE_ENV=development
PORT=4000
APP_NAME=FlowForge
API_VERSION=v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://flowforge:flowforge_secret@localhost:5432/flowforge_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# BullMQ
BULL_REDIS_URL=redis://localhost:6379
BULL_PREFIX=flowforge

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:5173

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@flowforge.dev

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000
VITE_APP_NAME=FlowForge
